{
  "manifest_version": 2,
  "name": "OriPass",
  "version": "0.1.0",
  "description": "The logins for a site, from the OriPass app, under the page's own fields.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "background": {
    "scripts": ["suffix.js", "background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "OriPass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["menu.js", "fields.js", "typed.js", "toast.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["page.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": ["wrapper.js"],
  "permissions": ["nativeMessaging", "tabs", "storage", "alarms"]
}
